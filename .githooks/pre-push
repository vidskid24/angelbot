#!/bin/sh
# Auto-append pushed commits into VERSION-NOTES.txt (personal notes).
# Enable once: npm run notes:hooks

cd "$(git rev-parse --show-toplevel)" || exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "version-notes: node not found; skipping VERSION-NOTES update."
  exit 0
fi

# Forward pre-push ref lines from stdin
node scripts/append-version-notes.js --from-push
exit 0
