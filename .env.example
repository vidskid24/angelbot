# Web API (bootstrap short-lived app token)



PORT=3000



# Render PostgreSQL (required for saved threads + durable chat history)



DATABASE_URL=



# Set to false only for local Postgres without SSL



# DATABASE_SSL=false







# Comma-separated site origins where the embed runs (scheme + host only, no path)



CORS_ORIGINS=https://courses.masteringalchemy.com







# Optional explicit allowlist for bootstrap endpoint (defaults to CORS_ORIGINS)



# BOOTSTRAP_ALLOWED_ORIGINS=https://courses.masteringalchemy.com







# Bootstrap token TTL in seconds (default 3600, max 86400)



# APP_BOOTSTRAP_TOKEN_TTL_SECONDS=3600







APP_SESSION_SECRET=







# Google Gemini (chat, title/summary, and embeddings)



GEMINI_API_KEY=



GEMINI_CHAT_MODEL=gemini-2.5-pro



GEMINI_EMBEDDING_MODEL=gemini-embedding-001







# Thread limits by tier (OMIBOT_* preferred; ANGELBOT_* still works as fallback)



# OMIBOT_FREE_THREAD_LIMIT=3



# OMIBOT_PAID_THREAD_LIMIT=15



# OMIBOT_FREE_DAILY_MESSAGE_LIMIT=15



# OMIBOT_PAID_DAILY_MESSAGE_LIMIT=110



# OMIBOT_DAILY_LIMIT_TIMEZONE=America/Los_Angeles



# Paid memory: nightly summary timezone (defaults to OMIBOT_DAILY_LIMIT_TIMEZONE)



# OMIBOT_MEMORY_TIMEZONE=America/Los_Angeles

# Pause between paid users during nightly memory cron (ms; default 3000, 0 = no delay)

# OMIBOT_MEMORY_USER_DELAY_MS=3000



# Cron secret for POST /internal/jobs/regenerate-memory (Render cron)



# OMIBOT_CRON_SECRET=



# OMIBOT_TIER_CACHE_MINUTES=60







# Paid tier: Thinkific active enrollment
# API Access Token from Settings → Code & analytics (Bearer auth; NOT the SSO Signing Secret)



# THINKIFIC_API_KEY=



# Comma-separated numeric course/product ids and/or exact names (case-insensitive), e.g.:
# THINKIFIC_PAID_PRODUCT_IDS=3436925







# Paid tier: testing overrides



# OMIBOT_PAID_USER_IDS=77823481,user@example.com



# OMIBOT_FORCE_TIER=paid







# RAG style guides



STYLE_GUIDES_PATH=data/style-guides







# Optional: Dropbox instead of local style guides



# DROPBOX_ACCESS_TOKEN=



# DROPBOX_FOLDER_PATH=







# Optional tuning



# MAX_HISTORY_TURNS=10



# RATE_LIMIT_PER_MINUTE=5



# GEMINI_EMBED_MAX_CONCURRENCY=2



# GEMINI_EMBED_RETRY_MAX=3



# GEMINI_EMBED_RETRY_BASE_MS=400



# GEMINI_EMBED_CACHE_TTL_MS=600000



# GEMINI_EMBED_CACHE_MAX_ENTRIES=500



# GEMINI_EMBED_METRICS_LOG=false



# GEMINI_EMBED_METRICS_LOG_INTERVAL_MS=30000

