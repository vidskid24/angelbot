# Web API (bootstrap short-lived app token)

PORT=3000

# Comma-separated site origins where the embed runs (scheme + host only, no path)

CORS_ORIGINS=https://courses.masteringalchemy.com

# Optional explicit allowlist for bootstrap endpoint (defaults to CORS_ORIGINS)

# BOOTSTRAP_ALLOWED_ORIGINS=https://courses.masteringalchemy.com

# Bootstrap token TTL in seconds (default 3600, max 86400)

# APP_BOOTSTRAP_TOKEN_TTL_SECONDS=3600

APP_SESSION_SECRET=



# Google Gemini (chat, title/summary, and embeddings)

GEMINI_API_KEY=

GEMINI_CHAT_MODEL=gemini-2.5-pro

GEMINI_EMBEDDING_MODEL=gemini-embedding-001



# RAG style guides

STYLE_GUIDES_PATH=data/style-guides



# Optional: Dropbox instead of local style guides

# DROPBOX_ACCESS_TOKEN=

# DROPBOX_FOLDER_PATH=



# Optional tuning

# MAX_HISTORY_TURNS=10

# RATE_LIMIT_PER_MINUTE=5

# GEMINI_EMBED_MAX_CONCURRENCY=2

# GEMINI_EMBED_RETRY_MAX=3

# GEMINI_EMBED_RETRY_BASE_MS=400

# GEMINI_EMBED_CACHE_TTL_MS=600000

# GEMINI_EMBED_CACHE_MAX_ENTRIES=500

# GEMINI_EMBED_METRICS_LOG=false

# GEMINI_EMBED_METRICS_LOG_INTERVAL_MS=30000

