{
  "name": "omibot",
  "version": "1.0.0",
  "description": "Omi Bot — Web companion API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "ingest": "node src/rag/run-ingest.js",
    "ingest:new": "node src/rag/run-ingest.js --new",
    "catalog:validate": "node scripts/validate-course-catalog.js",
    "metrics:embed": "node scripts/summarize-embed-metrics.js",
    "notes:hooks": "node scripts/setup-version-notes-hooks.js",
    "notes:log": "node scripts/append-version-notes.js",
    "db:migrate": "node -e \"import('dotenv/config'); import('./src/db/migrate.js').then(m => m.runMigrations()).then(() => console.log('Done')).catch(e => { console.error(e); process.exit(1); })\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "web",
    "thinkific",
    "wisdom",
    "companion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0"
  }
}
